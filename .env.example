# ==============================================================================
# LEARNVERSE Unified Production Backend Configuration (.env.example)
# Target Host: Ubuntu 22.04 LTS · 2 vCPU / 2 GiB RAM / 40 GiB ESSD
# Architecture: Nginx (Static + Reverse Proxy /api/*) -> FastAPI + SQLite WAL + Redis + Docker Sandbox
# Copy this file to `.env` and fill in production secrets before deployment.
# NEVER commit `.env` or real secrets to version control!
# ==============================================================================

# --- 1. Application & Server (2C2G Tuned) ---
LEARNVERSE_ENV=production
LEARNVERSE_HOST=127.0.0.1
LEARNVERSE_PORT=8000
# Recommended workers on 2 vCPU / 2 GiB RAM: 1 (async loop + SQLite/Argon2 thread pools; keeps sandbox semaphores global)
LEARNVERSE_WORKERS=1
# Trusted reverse-proxy CIDRs allowed to supply X-Real-IP / X-Forwarded-For
LEARNVERSE_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
# Allowed Origin hostnames for CSRF / same-origin checks (comma-separated, empty allows matching Host header)
LEARNVERSE_ALLOWED_ORIGINS=https://learnverse.example.com,http://127.0.0.1:5173,http://127.0.0.1:4173

# --- 2. SQLite WAL Storage ---
# Unified database storing users, sync progress, card vault, discussions, and AI QA logs
LEARNVERSE_SQLITE_PATH=/var/lib/learnverse/learnverse.sqlite
# Optional legacy discussion SQLite file to auto-migrate on first startup
LEARNVERSE_LEGACY_DISCUSSION_DB=.learnverse/discussions.sqlite
# SQLite page cache limit per connection in KiB (-16000 = ~16 MiB, preventing memory bloat on 2 GiB RAM)
LEARNVERSE_SQLITE_CACHE_KB=-16000
LEARNVERSE_SQLITE_BUSY_TIMEOUT_MS=5000

# --- 3. Redis (Captcha TTL, Sliding-Window Rate Limiter, JWT Revocation) ---
# Production: redis://127.0.0.1:6379/0 (Use memory:// only for isolated local unit tests)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=lv:

# --- 4. Authentication, JWT & Argon2 Memory Bounds ---
# Generate with: openssl rand -hex 32 (MUST be at least 32 characters in production)
JWT_SECRET_KEY=CHANGE_ME_TO_A_64_HEX_CSPRNG_SECRET_IN_PRODUCTION_0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_COOKIE_NAME=lv_access_token
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax
# Argon2id tuned for 2C2G: 19 MiB (19456 KiB) * max 2 concurrent hashers = max 38 MiB peak
PASSWORD_HASH_SCHEME=argon2id
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_HASH_CONCURRENCY_LIMIT=2
CAPTCHA_TTL_SECONDS=300
# Optional Admin secret token for /api/admin/* management endpoints (or use an admin-role JWT)

# --- 5. Optional Email Verification (465 SSL SMTP or HTTPS API, Not Hardcoded) ---
EMAIL_VERIFICATION_ENABLED=false
# Mode: "smtp_ssl" (Port 465 SSL) or "https_api"
EMAIL_PROVIDER_MODE=smtp_ssl
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=LEARNVERSE <noreply@example.com>
# Optional HTTPS Transactional Email Provider (e.g., Resend / SendGrid compatible)
EMAIL_HTTPS_API_URL=
EMAIL_HTTPS_API_KEY=
EMAIL_OTP_TTL_SECONDS=600
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- 6. OpenAI-Compatible AI Q&A Proxy (SSE) ---
# Strictly loaded from environment variables; never commit real API keys!
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Shared site-wide daily token budget (Asia/Shanghai). 0 pauses upstream requests.
AI_DAILY_TOKEN_BUDGET=200000
# Pre-flight zero-cost syntax interceptor: if false, returns deterministic syntax card immediately at 0 token cost;
# if true, streams the zero-cost diagnostic card first and then passes through to upstream LLM.
AI_INTERCEPT_PASSTHROUGH=false
# Dual-dimension sliding window rate limits & truncation bounds
AI_RATE_LIMIT_USER_PER_MINUTE=10
AI_RATE_LIMIT_USER_PER_HOUR=60
AI_RATE_LIMIT_USER_PER_DAY=20
AI_GUARDIAN_DAILY_BONUS=10
AI_RATE_LIMIT_IP_PER_MINUTE=20
AI_MAX_QUESTION_CHARS=2000
AI_MAX_CODE_CHARS=8000
AI_MAX_ERROR_CHARS=2000

# --- 6b. GitHub One-Click Star Guardian (Seoul Genesis Node) ---
# Set DEBUG=true ONLY in local dev to unlock /api/github/mock-star
DEBUG=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TARGET_OWNER=learnverse-dev
GITHUB_TARGET_REPO=learning-station
# Local: http://localhost:8000/api/github/callback | Production: https://golearnverse.com/api/github/callback
GITHUB_REDIRECT_URI=https://golearnverse.com/api/github/callback
GITHUB_GUARDIAN_LIMIT=100

# --- 7. Chapter Discussions Moderation & Rate Limiting ---
DISCUSSION_RATE_LIMIT_PER_MINUTE=20
# Comma-separated custom blocked keywords (in addition to built-in XSS/spam rules)
DISCUSSION_BLOCKED_KEYWORDS=赌博,色情,代考,外挂,诈骗,刷单

# --- 8. 2C2G Hardened Docker Micro-Sandbox (C & Java) ---
# Mode: "docker" (REQUIRED for production). NEVER execute untrusted code on the host!
SANDBOX_BACKEND=docker
DOCKER_BIN=docker
SANDBOX_TEMP_ROOT=/tmp/learnverse-sandbox

# C Sandbox (Alpine + GCC, lightweight, max 2 concurrent containers)
SANDBOX_C_IMAGE=learnverse-sandbox-c:latest
SANDBOX_C_CONCURRENCY=2
SANDBOX_C_MAX_QUEUE=6
SANDBOX_C_QUEUE_TIMEOUT_SECONDS=3.0
SANDBOX_C_MEMORY_LIMIT=96m
SANDBOX_C_CPUS=0.75
SANDBOX_C_PIDS_LIMIT=32
SANDBOX_C_COMPILE_TIMEOUT_SECONDS=6.0
SANDBOX_C_RUN_TIMEOUT_SECONDS=4.0

# Java Sandbox (Alpine + OpenJDK, memory-intensive: GLOBAL SINGLE CONCURRENCY = 1 + strict -Xmx)
SANDBOX_JAVA_IMAGE=learnverse-sandbox-java:latest
SANDBOX_JAVA_CONCURRENCY=1
SANDBOX_JAVA_MAX_QUEUE=2
SANDBOX_JAVA_QUEUE_TIMEOUT_SECONDS=2.5
SANDBOX_JAVA_MEMORY_LIMIT=320m
SANDBOX_JAVA_CPUS=1.0
SANDBOX_JAVA_PIDS_LIMIT=48
SANDBOX_JAVAC_MAX_HEAP=144m
SANDBOX_JAVA_MAX_HEAP=96m
SANDBOX_JAVA_COMPILE_TIMEOUT_SECONDS=8.0
SANDBOX_JAVA_RUN_TIMEOUT_SECONDS=5.0
